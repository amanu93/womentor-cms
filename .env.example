# Prisma connection string. SQLite by default; for PostgreSQL also change
# `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Random string, 32+ characters. Reserved for signed tokens; sessions are
# currently stored in the database.
SESSION_SECRET="change-me-to-a-long-random-string"

# First admin account, created by `npm run db:seed`.
ADMIN_EMAIL="admin@womentorafrica.com"
ADMIN_PASSWORD="change-me"

# Where uploaded media is stored (relative to the project root or absolute).
UPLOAD_DIR="uploads"
